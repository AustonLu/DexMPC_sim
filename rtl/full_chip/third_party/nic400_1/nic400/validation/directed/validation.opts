# ----------------------------------------------------------------------------
# Purpose : Defines the mapping between service modules and tools
# --========================================================================--

# TOOL to SM mapping (used by simulate SM)
tool = {'default': 'directed_mti',
         'mti'   : 'directed_mti',
         'vcs'   : 'directed_vcs',
         'nc'    : 'directed_nc'}

# Extra options for the tool SMs
tool_options    = {'default': '--no_cdc'}

# TARGET to SM mapping (used by compile module)
target =  {'env': 'directed_so',
           'mti': 'mti_compile',
           'vcs': 'vcs_compile',
           'nc' : 'nc_compile'}

# Extra options for the target SMx
target_options  = {'mti': '--no_cdc'}

# Source directories for tests in priority order 
test_src_dirs = [ '../source',
                  '../../../shared/validation/common/directed/source']
