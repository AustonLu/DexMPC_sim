VERBOSITY ALL INFO 

SCENARIO 1 "All transaction types"

ACTION *AXIM_* "maximum active reads = 16"
ACTION *AXIM_* "maximum active writes = 16"
ACTION *AXIM_* "write data interleaving depth = 1"
ACTION *AXIS_* "allow separate id streams = true"
ACTION *AXIS_* "read timing arbitration = round robin"
ACTION *AXIS_* "wait for aw = true"
ACTION * "execute vector files"

EXECUTE 1

