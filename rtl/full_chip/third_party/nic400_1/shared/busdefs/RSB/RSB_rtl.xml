<spirit:abstractionDefinition xmlns:spirit="http://www.spiritconsortium.org/XMLSchema/SPIRIT/1.4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.spiritconsortium.org/XMLSchema/SPIRIT/1.4                       http://www.spiritconsortium.org/XMLSchema/SPIRIT/1.4/index.xsd">
  <spirit:vendor>amba.com</spirit:vendor>
  <spirit:library>TBench</spirit:library>
  <spirit:name>RSB_rtl</spirit:name>
  <spirit:version>r0p0</spirit:version>
  <spirit:busType spirit:library="TBench" spirit:name="RSB" spirit:vendor="amba.com" spirit:version="r0p0" />
  <spirit:ports>
    <!-- This is the data of the bus. -->
    <spirit:port>
      <spirit:logicalName>RSB_DATA</spirit:logicalName>
      <spirit:description>
        Read Data	
</spirit:description>
      <spirit:wire>
        <spirit:onMaster>
          <spirit:presence>required</spirit:presence>
          <spirit:width>8</spirit:width>
          <spirit:direction>out</spirit:direction>
        </spirit:onMaster>
        <spirit:onSlave>
          <spirit:presence>required</spirit:presence>
          <spirit:direction>in</spirit:direction>
          <spirit:width>8</spirit:width>
        </spirit:onSlave>
      </spirit:wire>
    </spirit:port>
    <!-- Pointers -->
    <spirit:port>
      <spirit:logicalName>RSB_WPTR</spirit:logicalName>
      <spirit:description>
	Write pointer.
</spirit:description>
      <spirit:wire>
        <spirit:onMaster>
          <spirit:presence>required</spirit:presence>
          <spirit:direction>out</spirit:direction>
        </spirit:onMaster>
        <spirit:onSlave>
          <spirit:presence>required</spirit:presence>
          <spirit:direction>in</spirit:direction>
        </spirit:onSlave>
      </spirit:wire>
    </spirit:port>
    <spirit:port>
      <spirit:logicalName>RSB_RPTR</spirit:logicalName>
      <spirit:description>
	Read pointer.
</spirit:description>
      <spirit:wire>
        <spirit:onMaster>
          <spirit:presence>required</spirit:presence>
          <spirit:direction>in</spirit:direction>
        </spirit:onMaster>
        <spirit:onSlave>
          <spirit:presence>required</spirit:presence>
          <spirit:direction>out</spirit:direction>
        </spirit:onSlave>
      </spirit:wire>
    </spirit:port>
    <spirit:port>
      <spirit:logicalName>RSB_BIN_RPTR</spirit:logicalName>
      <spirit:description>
	Read pointer. (Binary)
</spirit:description>
      <spirit:wire>
        <spirit:onMaster>
          <spirit:presence>optional</spirit:presence>
          <spirit:direction>in</spirit:direction>
        </spirit:onMaster>
        <spirit:onSlave>
          <spirit:presence>optional</spirit:presence>
          <spirit:direction>out</spirit:direction>
        </spirit:onSlave>
      </spirit:wire>
    </spirit:port>
    <spirit:port>
      <spirit:logicalName>RSB_FIFO_EMPTY</spirit:logicalName>
      <spirit:description>Fifo empty (Binary)</spirit:description>
      <spirit:wire>
        <spirit:onMaster>
          <spirit:presence>optional</spirit:presence>
          <spirit:direction>out</spirit:direction>
          <spirit:width>1</spirit:width>
        </spirit:onMaster>
        <spirit:onSlave>
          <spirit:presence>optional</spirit:presence>
          <spirit:direction>in</spirit:direction>
          <spirit:width>1</spirit:width>
        </spirit:onSlave>
      </spirit:wire>
    </spirit:port>
  </spirit:ports>
  <spirit:description>
        Abstracted Bus definition of Register Sub System Bus
  </spirit:description>
</spirit:abstractionDefinition>
