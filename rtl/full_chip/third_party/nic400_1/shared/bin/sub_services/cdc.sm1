#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------
   
# Import the Base Class
from os import path, chdir, getcwd
from sm_base import sm_base
from ipfs_std_lib import *
from glob import glob

class cdc (sm_base):
   
   #-------------------------------------------------------------------------------
   # initialise - 
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call (NB lsf turned off as it should be on in sub
        #modules
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Set the name
        self.name = 'cdc'

        #Register workflow
        self.lsf_workflow = 'arm_engine-1.0-cdc'

        #Add license requirments -???
        self.licenses.append('0in')

        #Add tool requirements
        self.tools.append('0in')
        self.tools.append('perl')

        #Any lists etc required accross multiple blocks should be set up here
        self.files = ['run_cdc','work', 'Cdc_Results','Gui_Results', 'default', '.0in_ui_local_prefs']
        
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # options - This function registers all valid command line options for this SM
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

        #Clear options
        return 0     
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run - Goes through every specified location.
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

        #Set some useful variable names

        #determine PERIPH_LOGICAL and PERIPH_CONFIG
        dirs = directory.split('/')
        periph_config = dirs[len(dirs) - 4] 
        file_list = glob('../../verilog/' + periph_config + '.vc')
        file_list.extend(glob('../../validation/shared/tbench/*wrapper.vc'))
        default_project  = './cdc_checking.zpf'
        inc_file  = '+libext+.v -y ../../verilog -y ../../../reg_slice/verilog  +incdir+../../verilog +incdir+../../../nic400/verilog +incdir+../../../reg_slice/verilog'

        if len(self.args) == 1 and self.args[0] != 'default':
             (dir,filename) = path.split(self.args[0])
             target = filename[:-2]
             #Create a run script
             if self.options.gui:
                  run_script = ['##Running 0in_cdc for ' + filename,
                                '0in_cdc -p myproj  -d ' + target + '\\',
                                '-v ' + self.args[0] ];
             else:
                  run_script = ['##Running 0in_cdc for ' + filename,
                                '0in -od ' + target + ' -cmd cdc  -ctrl cdc_control.v -d ' + target + '\\',
                                '-v ' + self.args[0] + inc_file ];
        else:
             for file in file_list:
               #print '# wrapper seen = ' + file;
               if ("master" not in file and "slave" not in file):
                 vcfile = file
             #else:
             #  vcfile = file_list[0]
             vfile  = vcfile[:-1]
             (dir,filename) = path.split(vfile)

             if self.options.gui:     
                  run_script = ['##Load default project in GUI',
                                '../../../shared/validation/scripts/EnvSub.pl -infile=' + vcfile,
                                '0in_cdc -p default' ];
             else:
                  target = filename[:-2]
                  run_script = ['../../../shared/validation/scripts/EnvSub.pl -infile=' + vcfile,
                                '##Running 0in_cdc checking for default block',
                                '0in -od Cdc_Results -cmd cdc  -ctrl cdc_control.v -d ' + target + '\\',
                                '-v ' + vfile + ' -f ./tbench.vc',
                                '${ASSESSMENT_HOME}/scripts/zn_cdc_results.pl Cdc_Results cdc_results.xml'];


        #Write out script and run it
        self.write_run_script(run_script, 'run_cdc', args)
        return self.run_command(args, './run_cdc')

   #-------------------------------------------------------------------------------
   
   #-------------------------------------------------------------------------------
   # clean - A housekeeping function for the purpose of updating the status of the
   #          service after execution, and to perform clean-up of the workspace
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, directory):

        #disable lsf for clean operations
        self.use_lsf = 0 
        self.delete_files = self.files
   
        return 0; 

   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # help - 
   #-------------------------------------------------------------------------------
   def help_sm(self, args):
    
     #set the usage term
     self.parser.usage = "ae cdc [options] [module | default]"
  
     self.epilog = ["Specify a specific verilog name, otherwise default will be loaded"]    
         
     return 0;
