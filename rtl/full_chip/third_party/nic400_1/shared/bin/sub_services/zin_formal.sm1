#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------
   
# Import the Base Class
from os import path, chdir, getcwd
from sm_base import sm_base
from ipfs_std_lib import *
from glob import glob

class zin_formal (sm_base):
   
   #-------------------------------------------------------------------------------
   # initialise - 
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call (NB lsf turned off as it should be on in sub
        #modules
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Set the name
        self.name = 'zin_formal'

        #Register workflow
        self.lsf_workflow = 'arm_engine-1.0-formal_zin'

        #Add license requirments -???
        self.licenses.append('0in')

        self.search_file = 'formal.opts'
         
        #Add tool requirements
        self.tools.append('0in')

        #Any lists etc required accross multiple blocks should be set up here
        self.files = ['run_0in','work', 'zwork', '*.wlf', 'replay*', 'transcript', '*.db', '*.fcdb',
                      '0in_cache', 'SFV_SVA_RESULTS_VL', '.0in_ui_local_prefs','lsf_job_code',
                      'formal_results.xml']
        
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # options - This function registers all valid command line options for this SM
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

        if not group.parser.has_option("--disable_ovl"):          
              group.add_option("--disable_ovl", dest="ovl", action="store_false", 
                          default=True, help="Disable the built in OVLs")

        #Clear options
        return 0     
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run - Goes through every specified location.
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

        if self.options.ovl:
              ovl_enable_global = ' -ignore_translate_off -ovl +define+ASSERT_ON +define+ARM_ASSERT_ON  +define+OVL_ASSERT_ON '
        else:
              ovl_enable_global = ''
 
        #Now read in the search_file 
        terms = {}
        terms['top_modules'] = {}
        terms['ovl_off_list'] = []
        terms['ctrl_file_list'] = []
        execfile(directory + '/' + self.search_file, terms)


 
        #Set some useful variable names
        file_list  = glob(directory + '/*.zpf')
        inc_file  = '+libext+.sv ' + \
                    '+libext+.v ' + \
                    '-y ../../verilog ' + \
                    '-y ../../../cdc_blocks/verilog ' + \
                    '-y ../../../nic400/verilog ' + \
                    '-y ../../../nic400/verilog/Axi ' + \
                    '-y ../../../nic400/verilog/Ahb ' + \
                    '-y ../../../nic400/verilog/AxiPC ' + \
                    '-y ../../../nic400/verilog/AhbPC ' + \
                    '-y ../../../reg_slice/verilog ' + \
                    '-y ../../../shared/validation/tb_components ' + \
                    '-y ../../../shared/validation/tb_components/AxiFrs ' + \
                    '-y ./ ' + \
                    '+incdir+../../verilog ' + \
                    '+incdir+../../../cdc_blocks/verilog ' + \
                    '+incdir+../../../nic400/verilog ' + \
                    '+incdir+../../../nic400/verilog/Axi ' + \
                    '+incdir+../../../nic400/verilog/Ahb ' + \
                    '+incdir+../../../nic400/verilog/AxiPC ' + \
                    '+incdir+../../../nic400/verilog/AhbPC ' + \
                    '+incdir+../../../reg_slice/verilog ' + \
                    '+incdir+../../../shared/validation/tb_components ' + \
                    '+incdir+../../../shared/validation/tb_components/AxiFrs'

        if len(self.args) == 1 and self.args[0] != 'all':
             (dir,target) = path.split(self.args[0])
             vfile = directory + '/../../verilog/' + target + '.v '
             svafile = directory + '/' + target + '_sva.sv  ' 
             cuname  = ' -cuname ' + target + '_sva  '
             ctrlfile = ' '
             initfile = ' '
             vc_file = ' '
             top_module = target
             ovl_enable = ovl_enable_global
             if target in terms['top_modules']:
                 top_module = terms['top_modules'][target]
             if target in terms['ovl_off_list']:
                 ovl_enable = ''
             if target in terms['ctrl_file_list']:
                 ctrlfile = ' -ctrl ' +  target + '_ctrl.v '
             if target[-7:] == 'wrapper':
                 vfile = ' '
                 vc_file = '../../../shared/validation/scripts/EnvSub.pl -infile=' + directory + '/../../validation/shared/tbench/' + target + '.vc'
                 inc_file = ' -f ' + directory + '/tbench.vc +libext+.sv -y ./'
                 ctrlfile = ' -ctrl ' +  target + '_ctrl.v '
                 initfile = ' +0in_init+init.seq '
                 ovl_enable = ''
             if directory[-16:] == 'nic400/formal/sva':
                 vfile = directory + '/../../verilog/' + target + '.v '
                 vc_file = '../../../shared/validation/scripts/EnvSub.pl -infile=' + directory + '/../../verilog/' + target + '.vc'
                 inc_file = ' -f ' + directory + '/tbench.vc +libext+.sv -y ./ '
                 svafile = ' ' 
                 cuname  = ' '
                 ctrlfile = ' -ctrl ' +  target + '_ctrl.v '
                 initfile = ' +0in_init+init.seq '
             #Create a run script
             if self.options.gui:
                  run_script = ['0in_formal ' + target + '.zpf'];
             else:
                  run_script = [vc_file ,
                                '##Running 0-in for ' + target,
                                '0in -od CSL_' + target + ' \\',
                                '-cmd csl ' + vfile + svafile + ' \\',
                                inc_file + ovl_enable + ctrlfile + ' \\',
                                '-d ' + top_module + ' -sva ' + cuname,
                                '0in_prove +0in_od+PRV_' + target + initfile + ' \\',
                                '+0in_dir+CSL_' + target +'/0in_cache +0in_effort+high',
                                '0in_confirm +0in_import_dbs+PRV_' + target + '/0in_prove.db \\',
                                '+0in_od+PRV_' + target + initfile + ' \\' ];
        else:
             run_script = [];
             if len(file_list) == 0:
                 run_script.extend(['echo \\<\\?xml version=\\"1.0\\" encoding=\\"iso-8859-1\\" \\?\\> > formal_results.xml',
                                    'echo \\<Results\\> >> formal_results.xml',
                                    'echo \\<Result\\> >> formal_results.xml',
                                    'echo   \\<Type         \\>0-in Formal Log\\</Type\\> >> formal_results.xml',
                                    'echo   \\<LogFile      \\>N/A\\</LogFile\\> >> formal_results.xml',
                                    'echo   \\<Description  \\>No Formal tests to run\\</Description\\> >> formal_results.xml',
                                    'echo   \\<Pass         \\>1\\</Pass\\> >> formal_results.xml',
                                    'echo \\</Result\\> >> formal_results.xml',
                                    'echo \\</Results\\> >> formal_results.xml']);
             for file in file_list:
                 (dir,filename) = path.split(file)
                 target = filename[:-4]
                 vfile  = directory + '/../../verilog/' + target + '.v '
                 svafile = directory + '/' + target + '_sva.sv '
                 cuname  = ' -cuname ' + target + '_sva  '
                 ctrlfile = ' '
                 initfile = ' '
                 vc_file = ' '
                 top_module = target
                 ovl_enable = ovl_enable_global
                 if target in terms['top_modules']:
                     top_module = terms['top_modules'][target]
                 if target in terms['ovl_off_list']:
                     ovl_enable = ''
                 if target in terms['ctrl_file_list']:
                     ctrlfile = ' -ctrl ' +  target + '_ctrl.v '
                 if target[-7:] == 'wrapper':
                     vfile = ' '
                     vc_file = '../../../shared/validation/scripts/EnvSub.pl -infile=' + directory + '/../../validation/shared/tbench/' + target + '.vc'
                     inc_file = ' -f ' + directory + '/tbench.vc +libext+.sv -y ./ '
                     ctrlfile = ' -ctrl ' +  target + '_ctrl.v  '
                     initfile = ' +0in_init+init.seq '
                     ovl_enable = ''
                 if directory[-16:] == 'nic400/formal/sva':
                     vfile = directory + '/../../verilog/' + target + '.v '
                     vc_file = '../../../shared/validation/scripts/EnvSub.pl -infile=' + directory + '/../../verilog/' + target + '.vc'
                     inc_file = ' -f ' + directory + '/tbench.vc +libext+.sv -y ./ '
                     svafile = ' ' 
                     cuname  = ' '
                     ctrlfile = ' -ctrl ' +  target + '_ctrl.v  '
                     initfile = ' +0in_init+init.seq '
                 run_script.extend([vc_file ,
                                    '##Running 0-in for ' + target,
                                    '0in -od CSL_' + target + ' \\',
                                    '-cmd csl ' + vfile + svafile + ' \\',
                                    inc_file + ovl_enable + ctrlfile + ' \\',
                                    '-d ' + top_module + ' -sva ' + cuname,
                                    '0in_prove +0in_od+PRV_' + target + initfile + ' \\',
                                    '+0in_dir+CSL_' + target +'/0in_cache +0in_effort+high',
                                    '0in_confirm +0in_import_dbs+PRV_' + target + '/0in_prove.db \\',
                                    '+0in_od+PRV_' + target + initfile + ' \\',
                                    '+0in_dir+CSL_' + target +'/0in_cache +0in_effort+high',
                                    '${ASSESSMENT_HOME}/scripts/zn_formal_results.pl CSL_' + target + ' \\',
                                    'PRV_' + target + ' formal_results.xml']);             


        #Write out script and run it
        self.write_run_script(run_script, 'run_0in', args)
        return self.run_command(args, './run_0in')

   #-------------------------------------------------------------------------------
   
   #-------------------------------------------------------------------------------
   # clean - A housekeeping function for the purpose of updating the status of the
   #          service after execution, and to perform clean-up of the workspace
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, directory):

        #disable lsf for clean operations
        self.use_lsf = 0 
        self.delete_files = self.files

        #If args 0 is 'all' delete all run directories
        if len(self.args) == 0 or self.args[0] == 'all':
             self.delete_files.extend(['CSL_*', 'PRV_*']);
        else:
             (dir,target) = path.split(self.args[0]) 
             self.delete_files.extend(['CSL_'+ target, 'PRV_'+ target]);
   
        return 0; 
        
   #-------------------------------------------------------------------------------
