#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------

# Import standard modules
from os import path, chdir, mkdir
from sm_base import sm_base
from ipfs_std_lib import *
from shutil import copy as filecopy


class mti_compile (sm_base):

   #-------------------------------------------------------------------------------
   # initialise -
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Set the name
        self.name = 'mti_compile'

        #Register workflow
        self.lsf_workflow = 'arm_engine-1.0-comp_mti'

        #Register license requirements
        self.licenses.append('modelsim')

        #Register tool requirements
        self.tools.append('modelsim')
        self.tools.append('perl')

        #Set up dependency checks
        self.enable_dep_check = True;

   #-------------------------------------------------------------------------------
   # run_pre_dep - Called before dependencies are processed in the base class
   #-------------------------------------------------------------------------------
   def run_pre_dep(self, args, directory):

        self.output_dir = self.gen_compile_dir();

        return 0
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # options - This function registers all valid command line options for this SM
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

         if not group.parser.has_option("--disable_ovl"):
             group.add_option("--disable_ovl", dest="ovl", action="store_false",
                          default=True, help="Disable the built in OVLs")
         if not group.parser.has_option("--specman"):
             group.add_option("--specman", dest="specman", action="store_true",
                              default=False, help=SUPPRESS_HELP)
         if not group.parser.has_option("--vpe"):
             group.add_option("--vpe", dest="vpe", action="store_true",
                              default=False, help=SUPPRESS_HELP)
         if not group.parser.has_option("--no_cdc"):
             group.add_option("--no_cdc", dest="cdc", action="store_false",
                              default=True, help="Disable built in CDC checks")
         if not group.parser.has_option("--cdc_block_level"):
             group.add_option("--cdc_block_level", dest="cdc_bl", action="store_true",
                              default=False, help=SUPPRESS_HELP)
         if not group.parser.has_option("--directed"):
             group.add_option("--directed", dest="directed", action="store_true",
                              default=False, help=SUPPRESS_HELP)
         if not group.parser.has_option("--tc_check"):
             group.add_option("--tc_check", dest="tc_check", action="store_true",
                              default=False, help="Check the register types")
         if not group.parser.has_option("--sdf"):
             group.add_option("--sdf", dest="sdf", action="store_true",
                              default=False, help="Add SDF delays")
         if not group.parser.has_option("--silent"):
             group.add_option("--silent", dest="silent", action="store_true",
                  default=False, help="Disable OVL warnings about improper transactions to AHB and APB")
         if not group.parser.has_option("--netlist"):
             group.add_option("--netlist", dest="netlist", action="store",
                  default='\0', help="Replace DUT RTL with the netlist.  Specify the directory relative to the trunk/implementation/<config>/synopsys directory.  E.g. '--nelist=run_top_533MHz'")
         if not group.parser.has_option("--parcfg"):
             group.add_option("--parcfg", dest="parcfg", default='nic400', type='string',
                          help="Name of the product to render")
         if not group.parser.has_option("--clk_period"):
             group.add_option("--clk_period", dest="clk_period", action="store", default="50",
                          help = SUPPRESS_HELP)
         if not group.parser.has_option("--trace"):
             group.add_option("--trace", dest="trace", action="store_true",
                              default=False, help=SUPPRESS_HELP)


         #Complete
         return 0
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run - Run the sub_module
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

        #Create a run script
        run_script = ['setenv PERIPH_LOGICAL ' + path.normpath(directory + '../../../../')]

        # if selecting to run a netlist compile
        config_name = path.basename(path.normpath(directory + '../../../../'));
        spirit_subs = ''
        run_stitch = ''
        vc_file_location = '../../shared/tbench/tbench.vc'
        net_compile_opts = ''


        periph_implementation = sub(r'/logical/([^/]+)\/.*$', r'/implementation/\1', directory)

        netlist_location = '../../../../../../implementation/'+config_name+'/synopsys/data/'+config_name+'.'+self.options.netlist
        netlist_dir = '../../../../../../implementation/'+config_name+'/synopsys/data/'
        netlist_leafname = config_name+'.'+self.options.netlist

        if hasattr(self.options, 'netlist') and self.options.netlist != '\0':
             spirit_subs = ['setenv NETLIST_EXTENSION \"'+self.options.netlist+'\"',
                            'create_verilog_wrapper.pl -cfg '+config_name+' -del 10 -p '+netlist_dir+' -i '+netlist_leafname+'.v -o '+config_name+'_wrapper '+config_name,
                           '../../../../shared/validation/scripts/SpiritSub.pl -infile=../../../../spirit/' + config_name + '.xml']
             run_stitch = ['cd ../../shared/stitching/',
                          'if (! -e ../tbench_netlist) then',
                          'mkdir ../tbench_netlist',
                          'endif',
                          'generic_stitcher_core tbench_netlist_config.xml',
                          'cd -']
             vc_file_location = '../../shared/tbench_netlist/tbench.vc'

             net_compile_opts = ''
             if self.options.sdf == False:
                net_compile_opts = '+delay_mode_distributed +no_timing_checks'
             run_script.extend(['# Netlist VCD dump options',
                                'setenv NETLIST ' + self.options.netlist])

        # end netlist option varables

        #load specman module, request specman and mti_specman license
        if self.options.specman == True:
             self.licenses.append('specman')
             self.tools.append('specman')


        #load AVIP module
        if self.options.vpe == True:
             self.tools.append('vpe')


        # Generate the correct output directory name. Calls gen_compile_dir function.
        ldir = self.gen_compile_dir();


        if self.options.vpe == True:
             run_script.extend(['# Defining C++ library link options',
                                'setenv CMODE 64',
                                'setenv AVIP_DIR ${VPE_ROOT}',
                                'endif',
                                'if (! -d vpe) mkdir vpe',
                                'cd vpe',
                                    'make -C .. -f ${VPE_ROOT}/scripts/Makefile.user \\',
                                    '      "CMODE=${CMODE}" \\',
                                    '      "AXI_MASTER=0" \\',
                                    '      "AXI_SLAVE=0" \\',
                                    '      "AXI_MONITOR=1" \\',
                                    '      "OUTPUTLIB=vpe/libAVIP.so" \\',
                                    '      all',
                                'cd -'])


        #Disable tc_check if not in directed
        if self.options.tc_check and not self.options.directed:
             self.options.tc_check = False

        #If tc check is enabled
        if self.options.tc_check:
             #create a locl defs file
             run_script += ['closure_redef.pl -change']

        #Create directory
        self.cchdir(ldir);

        if self.options.specman == True:
             run_script.extend(['if (! -e ../e/specman.v) then',
                                'cd ../e',
                                'cp REMOVE.specman .specman',
                                'setenv XVC_ROOT ' + environ.get('XVC_ROOT'),
                                'setenv VPE_ROOT ' + environ.get('VPE_ROOT'),
                                'specman -c "load top.e; write stubs -verilog; quit"',
                                'cd -',
                                'endif'])

        run_script.extend(['if (! -d work) vlib work',
                           'vmap work ./work'])
        run_script.extend(spirit_subs)
        run_script.extend(run_stitch)

        if self.options.vpe == True:
             run_script.extend(['../../../../shared/validation/scripts/EnvSub.pl -infile=../source/common/vpefiles',
                                'mv tbench.vc vpefiles'])


        run_script.extend(['../../../../shared/validation/scripts/EnvSub.pl -infile=' + vc_file_location,
                           'vlog -64 +libext+.v+.vlib+.vh+.sv+.svh -incr -sv -novopt +nowarn+3010 +nowarn+3009 +incdir+. -y . '+ net_compile_opts +' \\'])

        if self.options.vpe == True:
             run_script.extend(['-f vpefiles \\'])

        run_script.extend(['-f tbench.vc \\'])

        if path.exists("../../shared/tb_components/dut_reg_check.v"):
             run_script.extend(['../../shared/tb_components/dut_reg_check.v \\'])

        # Timing closure compile
        if self.options.tc_check:
             run_script.append(self.options.parcfg + '_closure_' + directory.split('/')[-4][6:] + '_defs.v \\')

        # To load the lib AxiPC include, coz tbench.vc list all the files even they are not used
        run_script.extend(['-y ' + environ.get('ARM_OVL_VERILOG') + ' \\',
                           '+incdir+' + environ.get('ARM_OVL_VERILOG') + ' \\',
                           '+define+ARM_ASSERT_PSTRB_ON \\',
                           '+define+LIMIT_OVL \\'])

        if self.options.ovl == True:
             run_script.extend(['+define+ASSERT_ON \\',
                                '+define+OVL_ASSERT_ON \\',
                                '+define+OVL_INIT_MSG \\',
                                '+define+OVL_MAX_REPORT_ERROR=10 \\',
                                '+define+ARM_ASSERT_ON \\',
                                '+define+AXIPC_ON \\',])
        if self.options.vpe == True:
             run_script.extend(['+define+VPE \\'])
             run_script.extend(['+define+MTI \\'])

        if self.options.sdf == True:
             run_script.extend(['+define+SDF \\'])

        if self.options.trace == True:
            run_script.extend(['+define+TRACE \\'])

        if (float(self.options.clk_period) < 0.5):
            run_script.extend(['+define+PS_TIMESCALE \\'])

        if (self.options.clk_period != '50'):
            run_script.extend(['+define+INT_CLK_PERIOD=' + self.options.clk_period + ' \\'])
        
        #Add silent term
        if self.options.silent == True:
             run_script.extend(['+define+ARM_OVL_IGNORE_UNALIGN \\'])

        if self.options.cdc == True:
             run_script.extend(['+define+ARM_CDC_CHECK \\'])
        if self.options.cdc_bl == True:
             run_script.extend(['+define+ARM_CDC_BLOCK_LEVEL \\'])
        #Add netlist sim defines
        if hasattr(self.options, 'netlist') and self.options.netlist != '\0':
             maxwait = int (self.options.clk_period)
             maxwait2 = maxwait * 100
             run_script.extend(['+define+ARM_NET_SIM \\'])
             run_script.extend(['+define+MAXWAITS=' + str(maxwait2) + ' \\'])

        if self.options.specman == True:
             if self.options.directed == True:
                 run_script.extend(['+define+SPECMAN_COMPLETE ../e/specman.v \\',])
             else:
                 run_script.extend(['+define+SN ../e/specman.v \\',])

        #Add the compat argument
        run_script.append('-compat')


        #Write and execute run_script
        self.write_run_script(run_script, 'compile_src', args)
        return self.run_command(args, './compile_src')

   #-------------------------------------------------------------------------------
   # clean - clean the output of the sub_module
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, directory):

         self.use_lsf = 0
         self.delete_files.append('mti_compile*')
         self.delete_files.append('e/specman.v')

   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # gen_run_dir - Builds up the run directory name
   #-------------------------------------------------------------------------------
   def gen_compile_dir(self):

        comp_dir = 'mti_compile'

        if hasattr(self.options, 'netlist') and self.options.netlist != '\0':
            comp_dir += '_netlist'

        if hasattr(self.options, 'specman') and self.options.specman == True:
            comp_dir += '_sn'

        if hasattr(self.options, 'cdc') and self.options.cdc == False:
            comp_dir += '_ncdc'

        if self.options.tc_check:
            self.output_dir += "_tc"

        return comp_dir

   #-------------------------------------------------------------------------------

