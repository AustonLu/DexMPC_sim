#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------
   
# Import the Base Class
from os import path, environ
from sm_base import sm_base
from ipfs_std_lib import *
from optparse import SUPPRESS_HELP
from copy import copy
from re import findall

class tools (sm_base):
   
   #-------------------------------------------------------------------------------
   # initialise - 
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call (use_lsf amd use_tools are 0)
        sm_base.__init__(self, launch_dir, bin_paths, 0, 0)

        #Set the name
        self.name = 'tools'
        self.change_dir = False

        #Try to read in the configuration file
        cfgfile = self.get_path('/setup/tools.cfg')
        self.tool_map = {}

        #Set defaults for all options expected in the cfg file 
        self.tool_map['header'] = []
        self.tool_map['tools']  = {}

        if path.exists(cfgfile):
           try:
               execfile(cfgfile, self.tool_map)
           except:
               message( 'e1.01', 'Could not read the tools configuration file! %s' % exc_reason() )

   #-------------------------------------------------------------------------------
   # options - This function registers all valid command line options for this SM
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

         group.add_option("--tool_req", action="append", default=None,
                       type='string', dest="tool_req", help=SUPPRESS_HELP)  
         #Complete
         return 0     
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # env_replace - builds up the tool request line and returns it to the calling SM 
   #-------------------------------------------------------------------------------
   def env_replace(self, data, ignore_error):

       #find all all the regular expressions in data and replace them
       env_vars = findall('(\${([^}]*)})', data)

       #Go through each match
       for env_var in env_vars:

           #Get the value
           value = environ.get(env_var[1])
           # Put empty string and output error if requested 
           if (value == None):
              value = ''
              if not(ignore_error):
                  message( 'w1.00', 'Environment variable %s not defined!' % env_var[1])
           data = data.replace(env_var[0], value, 1)
       return data

   #-------------------------------------------------------------------------------
   # run - builds up the tool request line and returns it to the calling SM 
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

        #Build the tool request 
        tool_request = []

        #Add license requirments
        if self.options.tool_req != None and len(self.options.tool_req) > 0:
           for pre_command in self.tool_map['header']:
              tool_request.append(self.env_replace(pre_command, 0))
           for tool in self.options.tool_req:
              if tool in self.tool_map['tools'].keys():
                   #Add to the tool request array   
                   tool_request.append(self.env_replace(self.tool_map['tools'][tool], 0))
              else:     
                   message( 'w1.01', 'Unknown tool requested! %s' % tool )

        
        #Return a pass code and the tool request string
        return 0, {'tool_req': [item for item in tool_request if not item == '']}
   #-------------------------------------------------------------------------------
   
   
