#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------

# Import standard modules
from os import path, chdir, mkdir
from sm_base import sm_base
from ipfs_std_lib import *

class nc_compile (sm_base):

   #-------------------------------------------------------------------------------
   # initialise -
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Set the name
        self.name = 'nc_compile'

        #Register workflow
        self.lsf_workflow = 'arm_engine-1.0-comp_ius'

        #Register license requirements
        self.licenses.append('nc')

        #Register license requirements
        self.tools.append('nc')
        self.tools.append('perl')

        #Set up dependency checks
        self.enable_dep_check = True;

   #-------------------------------------------------------------------------------
   # run_pre_dep - Called before dependencies are processed in the base class
   #-------------------------------------------------------------------------------
   def run_pre_dep(self, args, directory):

        self.output_dir = 'nc_compile'

        #Add ncdc if not using cdc options
        if self.options.cdc == False:
             self.output_dir += '_ncdc'

        return 0

   #-------------------------------------------------------------------------------
   # options - This function registers options if not passed from directed_nc
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

        if not self.parser.has_option("--disable_ovl"):
            group.add_option("--disable_ovl", dest="ovl", action="store_false",
                             default=True, help="Disable the built in OVLs")
        if not group.parser.has_option("--no_cdc"):
             group.add_option("--no_cdc", dest="cdc", action="store_false",
                              default=True, help="Disable built in CDC checks")
        if not group.parser.has_option("--cdc_block_level"):
             group.add_option("--cdc_block_level", dest="cdc_bl", action="store_true",
                              default=False, help=SUPPRESS_HELP)

        #Complete
        return 0

   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run - Run the sub_module
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

        #Create a run script
        run_script = ['setenv PERIPH_LOGICAL ' + path.normpath(directory + '../../../../')]

        # Run NCPREP to create and set-up a 'work' directory. Both Specman and standalone
        run_script.extend(['../../../../shared/validation/scripts/EnvSub.pl -infile=../../shared/tbench/tbench.vc',
                      'ncprep +overwrite +sv +nowarn+LIBNOU -f tbench.vc \\',
                      '-y ' + environ.get('ARM_OVL_VERILOG') + ' \\',
                      '+incdir+' + environ.get('ARM_OVL_VERILOG') + ' \\',
                      '+define+ARM_ASSERT_PSTRB_ON \\',
                      '+define+LIMIT_OVL \\'])

        if self.options.ovl == True:
             run_script.extend(['+define+ASSERT_ON \\',
                                '+define+OVL_ASSERT_ON \\',
                                '+define+OVL_INIT_MSG \\',
                                '+define+OVL_MAX_REPORT_ERROR=10 \\',
                                '+define+ARM_ASSERT_ON \\',
                                '+define+AXIPC_ON \\'])
        #CDC logic
        if self.options.cdc == True:
             run_script.extend(['+define+ARM_CDC_CHECK \\'])
        if self.options.cdc_bl == True:
             run_script.extend(['+define+ARM_CDC_BLOCK_LEVEL \\'])

        run_script.append('+libext+.v+.vlib+.vh+.sv+.svh')

        # Run NCVLOG to compile the Verilog files.
        run_script.append('ncvlog -f ncvlog.args -nowarn RECOMP')


        # run NCELAB to elaborate the design object
        run_script.append('ncelab -f ncelab.args -timescale 1ns/1ps -access +rwc -nowarn MEMODR -nowarn MRSTAR')

        comp_dir = 'nc_compile'
        if hasattr(self.options, 'cdc') and self.options.cdc == False:
           comp_dir += '_ncdc'

        #Write and execute run_script
        self.cchdir(comp_dir);
        self.write_run_script(run_script, 'compile_src', args)
        return self.run_command(args, './compile_src')

   #-------------------------------------------------------------------------------
   # clean - clean the output of the sub_module
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, directory):

        comp_dir = 'nc_compile'
        if hasattr(self.options, 'cdc') and self.options.cdc == False:
           comp_dir += '_ncdc'


        self.use_lsf = 0
        self.delete_files.append(comp_dir)

