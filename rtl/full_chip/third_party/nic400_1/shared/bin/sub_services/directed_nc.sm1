#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------

# Import the Base Class
from os import path, chdir, remove, getcwd
from sm_base import sm_base
from ipfs_std_lib import *
from optparse import SUPPRESS_HELP
from shutil import copy as filecopy
from shutil import rmtree
from copy import copy
import sys

class directed_nc (sm_base):

   #-------------------------------------------------------------------------------
   # initialise -
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Register workflow
        self.lsf_workflow = 'arm_engine-1.0-sim_ius'

        #Set the name
        self.name = 'directed_nc'

        #Set the search_file .. used to identify source paths
        self.search_file = 'validation.opts'

        #Add a license requirment
        self.licenses.append('nc')

        #Add tool requests
        self.tools.append('nc')
        self.tools.append('g++')
        self.tools.append('perl')

        #Add any dependent SMs to the dependent services array
        self.dependent_services.append('directed_so')
        self.dependent_services.append('nc_compile')

        #Add reporting SM
        self.report_service = 'clean_test'

   #-------------------------------------------------------------------------------
   # report_sm - Run reporting functions
   #-------------------------------------------------------------------------------
   def report_sm(self, args, directory):

         report_args = copy(args)
         report_args.extend(["--target_dir", self.gen_run_dir()])

         #print "hi"
         #print report_args

         #If not using lsf clean up
         if self.use_lsf == 0 or not hasattr(self.options, "wait") or \
                 self.options.wait == None or len(self.options.wait) == 0:
              self.report_mod.run(report_args)
         else:
              res = sys.argv[0] + " simulate --report " + " ".join(report_args)
              #Schedule the call to reprot
              return self.run_command(args, res)
         #return
         return 0, {}

   #-------------------------------------------------------------------------------
   # run_pre_dep - Called before dependencies are processed in the base class
   #-------------------------------------------------------------------------------
   def run_pre_dep(self, args, directory):

        comp_dir = 'nc_compile'
        if hasattr(self.options, 'cdc') and self.options.cdc == False:
           comp_dir += '_ncdc'

        if self.options.recompile and path.exists(comp_dir) and not self.options.report:
             rmtree(comp_dir, 1)

        #Delete the Verilog compile directory
        return 0
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run - Run the sub_module
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):


        #determine PERIPH_LOGICAL and PERIPH_CONFIG
        dirs = directory.split('/')
        periph_config = dirs[len(dirs) - 4]
        periph_logical = '/'.join(dirs[:len(dirs) - 4])
        tb = dirs[len(dirs) - 1]

        #Check that test is defined
        if len(self.options.test) != 1:
             message( 'e1.01', 'Only one test name should be supplied to the %s SM!' % self.name )
             return 0, {}
        else:
             test = self.options.test[0]

        #Scan the serach file to get source directories
        terms = {}
        terms['test_src_dirs'] = []
        execfile(directory + '/' + self.search_file, terms)
        #set default
        terms['test_src_dirs'].append('./source')
        src_dir = ''

        #Find best match
        for try_src_dir in terms['test_src_dirs']:
            if path.exists(directory + '/' + try_src_dir + '/' + test + '.tsf'):
                 src_dir = path.normpath(directory + '/' + try_src_dir)
                 break
            elif path.exists(directory + '/' + try_src_dir + '/' + test + '/' + test + '.tsf'):
                 src_dir = path.normpath(directory + '/' + try_src_dir + '/' + test)
                 break

        #Fail if not found
        if src_dir == '':
             message( 'e1.02', 'Could not find a tsf file for the test %s!' % test )
             return 1, {}

        #Move to the run directory (create if necessary)
        self.cchdir(self.gen_run_dir())

        #Copy files to the new directory
        filecopy(src_dir + '/' + test + '.tsf', test + '.tsf')

        #Determine the system xml file
        if path.exists(directory + '/../../xml/system.xml'):
             system_xml = '../../../xml/system.xml'
        else:
             system_xml = '../../../../xml/' + periph_config + '.xml'

        comp_dir = 'nc_compile'
        if hasattr(self.options, 'cdc') and self.options.cdc == False:
           comp_dir += '_ncdc'

        #Create a run script
        #First cat the compile logs, then compile in the test code
        run_script = ['echo Verilog compile ' + comp_dir + ':',
                      'cat ../' + comp_dir + '/bsub.log',
                      'echo Environment compile directed_so:',
                      'cat ../directed_so/bsub.log',
                      'g++ -o ' + test + '.exe ../directed_so/pl301_model.so ' +
                      src_dir + '/' + test + '.cpp',
                      #Run the gnerated program
                      './' + test + '.exe ../../../xml/tbench_address_map.xml ' + system_xml,
                      #Set periph logical
                      'setenv PERIPH_LOGICAL ' + periph_logical + '/' + periph_config,
                      #Run the the vector generation script
                      '../../../../shared/validation/scripts/VecGen.pl',
                      #Set periph logical
                      'setenv PERIPH_LOGICAL ' + periph_logical ]

        #Add a -c flag in batch mode
        if self.options.gui:
            run_script.append('ncsim -gui -f ../' + comp_dir + '/ncsim.args -hdlvar ../' + comp_dir + '/hdl.var -cdslib ../' + comp_dir + '/cds.lib -uselicense IES')
        else:
            run_script.append('ncsim -f ../' + comp_dir + '/ncsim.args -hdlvar ../' + comp_dir + '/hdl.var -cdslib ../' + comp_dir + '/cds.lib -uselicense IES -input @run -input @finish')

        #Write compile run script and complete
        self.write_run_script(run_script, 'compile_run', args)
        return self.run_command(args, './compile_run')

   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # gen_run_dir - Builds up the run directory name
   #-------------------------------------------------------------------------------
   def gen_run_dir(self):

        #build_directory name
        run_dir = 'run_'
        if self.options.gui == True:
             run_dir = run_dir + 'gui_'
        #add tool, test name
        return run_dir + 'nc_' + self.options.test[0]

   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # clean_sm - Run the sub_module
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, directory):

        #Add the run_directory to the delete list
        self.delete_files.append(self.gen_run_dir())
