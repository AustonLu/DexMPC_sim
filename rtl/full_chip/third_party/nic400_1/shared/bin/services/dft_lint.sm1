#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------
   
# Import the Base Class
from os import path, chdir, getcwd
from sm_base import sm_base
from ipfs_std_lib import *
from glob import glob

class dft_lint (sm_base):
   
   #-------------------------------------------------------------------------------
   # initialise - 
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call (NB lsf turned off as it should be on in sub
        #modules
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Set the name
        self.name = 'dft_lint'

        #Register workflow
        self.lsf_workflow = 'arm_engine-1.0-lint'

        #Add license requirments -???
        self.licenses.append('spyglass')

        #Register report function
        self.self_report = True

        #Add tool requirements
        self.tools.append('spyglass')
        self.tools.append('xalan')
        self.tools.append('perl')

        #Any lists etc required accross multiple blocks should be set up here
        self.files = ['spyglass_dft.prj', 'spyglass.log',
                      'spyglass_reports', 'constraints.sgdc',
                      'run_spyglass_dft', 'result*', 'report_spyglass_dft']

   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # options - This function registers all valid command line options for this SM
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

        #Register Common options for simulate modules 

        #Clear options
        return 0     
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run - Goes through every specified location.
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

        #Set someuseful directory names
        policy_directory = path.normpath(environ.get("NIC400_INSTALL_DIR") + '/shared/logical/armrules') 
        verilog_directory = path.normpath(directory + '/../verilog')
        vc_directory = path.normpath(directory + '/../validation/shared/tbench/')
        v_name  = glob(vc_directory + '/*wrapper.vc')

        #If nothing look for a vc file in the top level instead
        if (len(v_name) == 0):
             v_name  = glob(directory + '/../verilog/*.vc')   

        #Quit if it's empty
        #if (len(v_name) == 0):
        #   return 1, {}     

        if ((len(self.args) != 1) or (len(self.args) == 1 and self.args[0] == "all")):
             target = "";   
             vfiles = '-f tbench.vc'
        else:
             target = self.args[0]    
             vfiles = verilog_directory + '/' + target + ' +incdir+' + verilog_directory + ' -y ' + verilog_directory;

        #determine PERIPH_LOGICAL
        dirs = directory.split('/')
        periph_logical = '/'.join(dirs[:len(dirs) - 2])

        #Switch between gui and batch
        mode = 'batch '
        if self.options.gui:
            mode = 'gui '

        #Create a run script
        run_script = ['setenv PERIPH_LOGICAL ' + periph_logical]

        #If using vc file get it, or assume local tbench.vc
        if (target == "" and len(v_name) != 0):
            run_script.extend(['../../shared/validation/scripts/EnvSub.pl -infile=' + v_name[0]])

        #Modify the vc file to work with Spyglass
        run_script.extend (['sed \'s/-v//\' < tbench.vc > tbench.f'])


        run_script.extend(['spyglass -project spyglass_dft.prj -' + mode + '-designread -goals initial_rtl/lint/\* -goals detailed_rtl/dft_readiness/\*']);

        #Write out script and run it
        self.write_run_script(run_script, 'run_spyglass_dft', args)
        return self.run_command(args, './run_spyglass_dft')

   #-------------------------------------------------------------------------------
   
   #-------------------------------------------------------------------------------
   # report - Sumarises the log files 
   #-------------------------------------------------------------------------------
   def report_sm(self, args, directory):

        #Remove uneeded license request 
        if self.licenses.count('spyglass') > 0:
            self.licenses.remove('spyglass')

        #Create report run script
#        run_script = ['$ASSESSMENT_HOME/scripts/spyglass_lint_results.pl ./spyglass.log ./spyglass.rpt raw.xml',
#                      '$ASSESSMENT_HOME/scripts/result_filter.pl raw.xml spyglass_filter.xml results.xml',
#                      'Xalan -o results.html results.xml $ASSESSMENT_HOME/scripts/results.xsl'];

        #Write out script and run it
#        self.write_run_script(run_script, 'report_spyglass_dft', args)
        return self.run_command(args, './report_spyglass_dft')

   #-------------------------------------------------------------------------------
   # clean - A housekeeping function for the purpose of updating the status of the
   #          service after execution, and to perform clean-up of the workspace
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, dir):

        #Delete all the files set up above
        self.delete_files = self.files

        #Add log file if use_lsf is on
        if self.use_lsf:
           self.delete_files.append(self.options.output_file)
     
        #Return ok
        return 0; 
   
   #-------------------------------------------------------------------------------
   
   #-------------------------------------------------------------------------------
   # help - 
   #-------------------------------------------------------------------------------
   def help_sm(self, args):
    
     #set the usage term
     self.parser.usage = "ae dft_lint [options]"
  
         
     return 0;
