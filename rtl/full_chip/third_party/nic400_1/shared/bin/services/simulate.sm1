#-------------------------------------------------------------------------------
# Module imports
#-------------------------------------------------------------------------------
   
# Import the Base Class
from os import path 
from sm_base import sm_base
from ipfs_std_lib import *
from copy import copy, deepcopy
import sys

class simulate (sm_base):
   
   #-------------------------------------------------------------------------------
   # initialise - 
   #-------------------------------------------------------------------------------
   def __init__(self, launch_dir, bin_paths, use_lsf, use_tool):

        #Pass on the __init__ call (NB lsf turned off as it should be on in sub
        #modules
        sm_base.__init__(self, launch_dir, bin_paths, use_lsf, use_tool)

        #Set the name
        self.name = 'simulate'

        #Set up the path control functionality 
        self.search_file = 'validation.opts'
        self.search_option = 'tool'
        self.option_config = 'tool_options'

   #-------------------------------------------------------------------------------
   # options - This function registers all valid command line options for this SM
   #-------------------------------------------------------------------------------
   def add_options(self, args, group):

        #Register Common options for simulate modules 
        group.add_option("--testgroup", dest="testgroup", action="store", default='default',
                       help='Select the test group to run')
        
        group.add_option("--tool", dest="tool", action="store", default='default',
                       help='Select the tool to use')

        #This option is suppressed as test names should be passed without an option
        group.add_option("--test",  dest="test", action="append", help=SUPPRESS_HELP)

        # Option to force a recompile of the verilog.
        group.add_option("--vlog", dest="recompile", action="store_true", default=False,
                       help='Force a re-compile of the verilog')

        #Tidy option ... used to reduce disk space by storing logs and deleting or
        #compressing logs after running.
        group.add_option("--tidy", dest="tidy", action="store_true", default=False,
                       help='Tidy up after running')


        #Clear options
        return 0     
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # check load_sub_services - The default is not enough for simulate.
   #                   It must extract the tool and testgroup options and check
   #                   That an appropriate SM and test group exists at the required 
   #                   location
   #-------------------------------------------------------------------------------
   def load_sub_services (self, directories, help):

        dir_copy = copy(directories)

        #Go through each directory
        for directory in dir_copy:
            
            #If there is no search file in the directory remove it from the list     
            if not path.exists(directory + '/' + self.search_file):
                directories.remove(directory)
                continue
 
            #Now read in the search_file 
            terms = {}
            terms[self.search_option] = {}
            terms[self.option_config] = {}
            execfile(directory + '/' + self.search_file, terms)

            #If the tool doesn't exist remove the directory 
            if not terms[self.search_option].has_key(getattr(self.options, self.search_option)):
                directories.remove(directory)
                continue

            #Check that there is a suitable test group in target directory    
            if self.options.testgroup == 'all':
                 if len(glob(directory + '/*.tg')) == 0:
                     directories.remove(directory)
                     continue
            else:
                 if not path.exists(directory + '/' + self.options.testgroup + '.tg'):
                     directories.remove(directory)
                     continue

            if not help or (len(directories) == 1):

                #All good .. we a suitable tool and test case so try and load the service module    
                sm_path = self.get_sm_path(directory, terms[self.search_option][getattr(self.options, self.search_option)])
                sm_ref = load_service(sm_path, self.launch_dir, self.bin_paths, self.use_lsf)

                #Store the loaded service module (against directory)
                if sm_ref != '':
                    #Store the reference to the service module
                    self.sub_modules[directory] = sm_ref
                    self.sub_module_names[directory] = sm_path
                    #Store extra options if they exist
                    if terms[self.option_config].has_key(getattr(self.options, self.search_option)):
                        self.sub_module_prefix[directory] = terms[self.option_config][getattr(self.options, self.search_option)]
                else:
                    directories.remove(directory)


        #Clear options
        return directories     
   #-------------------------------------------------------------------------------

   #-------------------------------------------------------------------------------
   # run_pre_dep - called before any dependencies are run
   #               Used here to add options to the command line
   #-------------------------------------------------------------------------------
   def run_pre_dep(self, args, directory):

       #If there are specified command line options for this directory add them
       extra_args = []
       if self.sub_module_prefix.has_key(directory):
            extra_args = self.sub_module_prefix[directory].split()

       for arg in extra_args:
          args.insert(0, arg);

       #Return complete
       return 0; 

   #-------------------------------------------------------------------------------
   # run_sm - Runs all the required tests
   #-------------------------------------------------------------------------------
   def run_sm(self, args, directory):

       return self.process_test_reqs(args, 'run', directory)

   #-------------------------------------------------------------------------------
   # Process_test_req - Goes through every specified test and calls the function 
   # specified by arg[2].
   #-------------------------------------------------------------------------------
   def process_test_reqs(self, args_in, function, dir):

       print 'Processing directory ', dir    

       #Make a local copy of args
       args = copy(args_in)

       #Identify and try and read the testgroup file from the current directory     
       #Check that testgroup exists
       tgroup_file = dir + '/' + self.options.testgroup + '.tg'
       if not path.exists(tgroup_file):
           message( 'w1.09', "Testgroup %s not defined for %s" % (self.options.testgroup, dir))
           return 

       #Create a dictionary to read file into and clear used parameters
       config = {}
       config['tests'] = []
       config['test_options'] = {}

       #Read it in
       try:   
           #Read in available tests
           execfile(tgroup_file, config)   
       except:    
           message( 'e1.09', "Failed to read %s (%s)" % (tgroup_file, exc_info()))
          
       #Create a list of tests to run (try everything that not a parameter on the command line)
       tests = self.args

       #Check that no tests have been defined as "--test"
       if self.options.test != None and len(self.options.test) > 0:
           tests = []
           tests.extend(self.options.test)    
           #remove all references to --test in the command line
           args = self.remove_option(args, '--test', 1)
  
       #If tests list is empty of all run all all tests     
       if len(tests) == 0 or (len(tests) == 1 and tests[0] == 'all'):
            tests = config['tests']   

       #Sort out the test list
       test_list, errors = self.list_match(config['tests'], tests)

       #Report warnings
       for error in errors:
            message( 'w1.09', "Requested test %s not available on %s" % (error, dir))

       #Job codes array     
       job_codes = []

       #Now try and run each test
       for test in test_list: 

            print 'Processing test ', test     
            full_args = copy(args)    

            # add the test name
            full_args.append('--test');
            full_args.append(test);

            #Add and test specific options
            if test in config['test_options']:
               full_args.extend(config['test_options'][test].split())     

            print full_args

            # If this is not the first test remove --vlog from the command line 
            if test_list.index(test) != 0:
                 full_args = self.remove_option(full_args, '--vlog', 0)

            # If there is a --deep attribute and this is not the first test remove it     
            if test_list.index(test) != 0 and hasattr(self.options, "deep"):
                 full_args = self.remove_option(full_args, '--deep', 0)
                    
            # If it is call functions   
            exec_statement = 'result = self.sub_modules[dir].' + function + '(full_args)'
            exec(exec_statement)

            #Quit if there was an error
            if (function == 'run'): 
               if result[0]:
                  return result;

               job_code = 0    
               if result[1].has_key('job_code'):
                   job_code = result[1]['job_code']

               #If tidy is turned on and there is a report option call it on this test   
               if self.options.tidy and hasattr(self.options, "report") and not self.options.report:

                     report_args = copy(full_args)
                     report_args.append("--report")

                     #If not using lsf
                     if self.use_lsf == 0:
                          result = self.sub_modules[dir].run(report_args)
                     else:
                          res = sys.argv[0] + " simulate " + " ".join(report_args)
                          #Add the wait if necessary
                          if job_code:
                               report_args.extend(["--wait", job_code[0]])   
                          #Schedule the call to run
                          result = self.run_command(report_args, res)

                     #Return on error
                     if result[0]:
                           return result     

               #Store the job codes if they exist   
               if result[1].has_key('job_code'):
                     job_codes.extend(result[1]['job_code'])   

            else:
               if result:
                  return result;
       
       #Give ok response     
       if (function == 'run'): 
          if (len(job_codes) > 0):    
              return 0, {'job_code' : job_codes}    
          else:        
              return 0, {};
       else:
          return 0    

   #-------------------------------------------------------------------------------
   
   #-------------------------------------------------------------------------------
   # clean - A housekeeping function for the purpose of updating the status of the
   #          service after execution, and to perform clean-up of the workspace
   #-------------------------------------------------------------------------------
   def clean_sm(self, args, directory):
   
     #Disable feature to automatically clean all loaded sub SMs
     self.use_lsf = 0

     #If args 0 is 'all' delete all run directories
     if len(self.args) > 0 and self.args[0] == 'all':
           self.delete_files.append('run*')
     else:      
           self.process_test_reqs(args, 'clean', directory)
   
     return 0; 
   
   #-------------------------------------------------------------------------------
   
   #-------------------------------------------------------------------------------
   # clean - A housekeeping function for the purpose of updating the status of the
   #          service after execution, and to perform clean-up of the workspace
   #-------------------------------------------------------------------------------
   def help_sm(self, args):
    
     #disable lsf for clean
     self.use_lsf = 0

     #set the usage term
     self.parser.usage = "ae simulate [options] tests"
  
     #Set the help epilog 
     group = self.parser.get_option_group('--testgroup')
     if len(self.directories) > 1:
         group.epilog = ["For help with tool/tb specific options and available tests specify the location (and tool/testgroup)"]    
     else:
         if not path.exists(self.directories[0] + '/' + self.options.testgroup + '.tg'):
             group.epilog = ["Specify a testgroup to see available tests"]    
         else:    
             group.epilog = ["Available tests for testgroup \'" + self.options.testgroup + "\' are:", ""]    
             
             #Open the testgroup 
             config = {}
             config['tests'] = []
             try:
                  execfile(self.directories[0] + '/' + self.options.testgroup + '.tg', config)   
                  group.epilog.append(', '.join(config['tests']))    
             except:
                  group.epilog = ["Specify a valid testgroup to see available tests"]    
         
     return 0; 
   
   #-------------------------------------------------------------------------------
