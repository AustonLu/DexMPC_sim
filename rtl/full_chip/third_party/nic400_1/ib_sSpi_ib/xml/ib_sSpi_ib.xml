<!ENTITY nic400_axi      SYSTEM "../../shared/busdefs/NIC400_AXI/NIC400_AXI.xml">
<!ENTITY nic400_axi_rtl  SYSTEM "../../shared/busdefs/NIC400_AXI/NIC400_AXI_rtl.xml">
<!ENTITY axi4            SYSTEM "../../shared/busdefs/AXI4/AXI4.xml">
<!ENTITY axi4_rtl        SYSTEM "../../shared/busdefs/AXI4/AXI4_rtl.xml">
<!ENTITY t_apb           SYSTEM "../../shared/busdefs/T_APB/T_APB.xml">
<!ENTITY t_apb_rtl       SYSTEM "../../shared/busdefs/T_APB/T_APB_rtl.xml">
<!ENTITY apbasync        SYSTEM "../../shared/busdefs/APBasync/APBasync.xml">
<!ENTITY apbasync_rtl    SYSTEM "../../shared/busdefs/APBasync/APBasync_rtl.xml">
<!ENTITY nic400_vn       SYSTEM "../../shared/busdefs/VN/VN.xml">
